# ═════════════════════════════════════════════════════════════════════════════════════════════
#  Configuración de PRODUCCIÓN del Café Aconcagua Chatbot
#
#  1. Copia este archivo:      cp deploy/produccion.env.example deploy/produccion.env
#  2. Ábrelo:                  nano deploy/produccion.env
#  3. Completa cada línea marcada con  <-- COMPLETAR  (sin espacios alrededor del =).
#  4. Guarda (Ctrl+O, Enter) y sal (Ctrl+X).
#
#  `deploy/produccion.env` tiene claves secretas: NUNCA lo subas a GitHub ni lo mandes por chat.
#  Ya está en .gitignore. La guía completa: docs/manual-produccion.md
# ═════════════════════════════════════════════════════════════════════════════════════════════

# ── Tu dominio ────────────────────────────────────────────────────────────────────────────────
# El subdominio que apunta a la IP del VPS (paso 3 del manual). Sin https:// ni barra final.
CAFE_DOMINIO=chatbot.tudominio.cl                     # <-- COMPLETAR

# ── Base de datos ─────────────────────────────────────────────────────────────────────────────
# Una clave larga inventada por ti (solo letras y números, 32 o más). Generar una:  openssl rand -hex 24
# No la cambies después de arrancar la primera vez: la base quedó creada con ella.
CAFE_DB_CLAVE=                                        # <-- COMPLETAR

# ── Modelo (OpenAI u otro compatible) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=                                       # <-- COMPLETAR (empieza por sk-)
CAFE_MODELO=gpt-6-luna
# Razonamiento del modelo: none, low, medium o high (más esfuerzo = más tokens y más lento).
CAFE_MODELO_ESFUERZO=medium
# Solo si usas otro proveedor compatible con OpenAI (SETUP.md, punto 9):
# CAFE_MODELO_BASE_URL=https://openrouter.ai/api/v1
# CAFE_MODELO_API=chat
# Tarifa del modelo en dólares por millón de tokens: entrada,cacheada,salida (de la página de precios
# del proveedor). OBLIGATORIA: sin ella el límite de gasto no puede cortar y el chatbot no arranca.
CAFE_MODELO_TARIFA_USD_POR_MTOK=                      # <-- COMPLETAR (ej: 1.25,0.125,10)
# Límite mensual en dólares. Avisa al equipo al 50, 80 y 100 %; al 100 % deja de usar el modelo.
CAFE_LIMITE_GASTO_USD_MES=50

# ── WhatsApp (app de Meta, paso 8 del manual) ─────────────────────────────────────────────────
META_ACCESS_TOKEN=                                    # <-- COMPLETAR (token permanente)
WHATSAPP_PHONE_NUMBER_ID=                             # <-- COMPLETAR
# Una palabra secreta inventada por ti; la misma se pega en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=                                # <-- COMPLETAR
WHATSAPP_APP_SECRET=                                  # <-- COMPLETAR (Configuración básica de la app)
# Plantillas aprobadas por Meta (nombres exactos):
WHATSAPP_PAYMENT_TEMPLATE=pago_recibido               # {{1}} nombre, {{2}} monto
WHATSAPP_HANDOFF_TEMPLATE=aviso_al_equipo             # {{1}} cliente, {{2}} motivo, {{3}} resumen
WHATSAPP_TEMPLATE_LANGUAGE=es

# ── Equipo ────────────────────────────────────────────────────────────────────────────────────
# Celulares que reciben los avisos, con código de país y sin +, separados por coma.
CAFE_EQUIPO_WHATSAPP=56911112222                      # <-- COMPLETAR
# Cómo el chatbot nombra a quien recibe un caso (un rol, no un nombre).
CAFE_ROL_ENCARGADO=la encargada

# ── Khipu (cobros) ────────────────────────────────────────────────────────────────────────────
# Sin clave, un pedido confirmado pasa a la encargada para que lo cobre.
KHIPU_API_KEY=                                        # <-- COMPLETAR
KHIPU_NOTIFY_URL=https://chatbot.tudominio.cl/payments/khipu/webhook   # <-- tu dominio
