# Copia este archivo a `.env` y complétalo. `.env` está en .gitignore: los secretos reales NUNCA entran al repo.

# ── Servidor ─────────────────────────────────────────────────────────────────
# desarrollo | produccion (en producción se exigen base de datos, firma de WhatsApp y tarifa).
CAFE_ENV=desarrollo
CAFE_PUERTO=8092
# PostgreSQL. Sin ella todo queda en memoria (solo desarrollo). Esta es la base de `docker compose up -d`,
# la que usan `pnpm semilla` y `pnpm local`; en producción va la base real.
DATABASE_URL=postgresql://cafe:cafe@127.0.0.1:5433/cafe_dev

# ── Modelo (un proveedor compatible con OpenAI) ─────────────────────────────
OPENAI_API_KEY=
# CAFE_MODELO_BASE_URL=https://api.openai.com/v1
CAFE_MODELO=gpt-6-luna
# CAFE_MODELO_ESFUERZO=none
# CAFE_MODELO_TIMEOUT_MS=25000
# Tarifa verificada del modelo en USD por millón de tokens: entrada,cacheada,salida (anota fuente y fecha).
# CAFE_MODELO_TARIFA_USD_POR_MTOK=entrada,cacheada,salida
# Límite mensual (mes de Chile). Se avisa al equipo al 50, 80 y 100 %; al 100 % no hay más inferencias.
CAFE_LIMITE_GASTO_USD_MES=50

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# META_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# META_GRAPH_API_VERSION=v25.0
# Plantilla aprobada «pago recibido»: {{1}} nombre del cliente, {{2}} monto pagado.
# WHATSAPP_PAYMENT_TEMPLATE=
# Plantilla aprobada «aviso al equipo»: {{1}} cliente, {{2}} motivo, {{3}} resumen.
# WHATSAPP_HANDOFF_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=es
# Números del equipo que reciben los avisos (con código de país, separados por coma).
# CAFE_EQUIPO_WHATSAPP=56911112222,56933334444
# Cómo el chatbot nombra a quien recibe un traspaso (un rol, nunca un nombre inventado).
# CAFE_ROL_ENCARGADO=la encargada

# ── Espera humana (ms) ───────────────────────────────────────────────────────
# CAFE_ESPERA_INCOMPLETA_MS=45000
# CAFE_VENTANA_AGRUPACION_MS=25000
# CAFE_ESPERA_CIERRE_MS=8000
# CAFE_TECHO_AGRUPACION_MS=180000
# CAFE_DESPACHO_CADA_MS=1000

# ── Cobro por Khipu ──────────────────────────────────────────────────────────
# Sin ella, un pedido confirmado pasa a la encargada para que lo cobre.
# KHIPU_API_KEY=
# URL pública de POST /payments/khipu/webhook, que se le pasa a Khipu al crear cada cobro.
# KHIPU_NOTIFY_URL=https://chatbot.cafeaconcagua.cl/payments/khipu/webhook

# ── Probar en local (`pnpm local` y `pnpm conversar`) ───────────────────────
# WhatsApp y Khipu siempre van a dobles locales; lo de arriba de WhatsApp y Khipu no se usa en local.
# CAFE_DOBLES_PUERTO=8093

# ── Solo pruebas: nunca en un despliegue real ────────────────────────────────
# CAFE_MODELO_BASE_URL=http://127.0.0.1:4600/llm/v1
# META_GRAPH_BASE_URL=http://127.0.0.1:4600/graph
# KHIPU_BASE_URL=http://127.0.0.1:4600/khipu/v3
